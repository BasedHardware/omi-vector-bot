# CommandCode Provider API key. Keep the real value in ignored .env / Railway secrets.
CMD_API_KEY=
CMD_MODEL=deepseek/deepseek-v4.1-flash
CMD_REVIEW_MODEL=
CMD_API_URL=https://api.commandcode.ai/provider/v1/chat/completions
CMD_TIMEOUT_MS=60000
# Discord — test bot (private channel first)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
VECTOR_TEST_CHANNEL_ID=

# Staff-only handoff delivery: configure STAFF_ALERT_CHANNEL_ID or both Telegram
# variables in production. A customer-visible Handoff card is not a delivery.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=
# Turns on answering in the public help forum. Leave empty until you want that.
# /done already works on forum posts for named staff without this.
# Order/email/privacy never belong there even if this is set later.
HELP_FORUM_CHANNEL_ID=
# Private staff-only Discord text channel; never a public help channel.
STAFF_ALERT_CHANNEL_ID=
# Named staff for /done, faq notes and private GitHub approvals.
# Direct channel-view grants must belong to these users or verified staff roles.
# Mods with Manage Threads remain authorized without being listed here.
STAFF_USER_IDS=
# Staff audience role (also accepted for private GitHub controls).
STAFF_ROLE_ID=
# GitHub App (preferred). Issues post as the app, not a person.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional fallback only. Do not use a personal PAT.
GITHUB_TOKEN=
GITHUB_REPO=BasedHardware/omi
GITHUB_WEBHOOK_SECRET=
# Set to 0 to skip creating a Handoff thread on the user message
HANDOFF_THREADS=1
PORT=3000

# Optional. Read-only Shopify Admin API. Never commit the token.
# Store can be "your-shop" or "your-shop.myshopify.com"
SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=
# Required for encrypted /order bindings and durable GitHub drafts/approvals.
# 32 bytes, base64: openssl rand -base64 32. Rotate only with a data migration.
DATA_ENCRYPTION_KEY=
# Resend. Without both, /order stays dark and tells people to email help@omi.me.
RESEND_API_KEY=
EMAIL_FROM=
